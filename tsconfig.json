{
  "compilerOptions": {
    "module": "esnext",
    "target": "es6",
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ],
      "@views/*": [
        "src/screens/views/*"
      ],
      "@styles/*": [
        "styles/*"
      ]
    }
  },
  "extends": "expo/tsconfig.base"
}
